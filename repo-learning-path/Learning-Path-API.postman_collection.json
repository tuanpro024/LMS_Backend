    "item": [
        {
            "name": "Package (Learning Path)",
            "item": [
                {
                    "name": "Create Package",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test(\"Status code is 201\", function () {",
                                    "    pm.response.to.have.status(201);",
                                    "});",
                                    "",
                                    "pm.test(\"Response has success status\", function () {",
                                    "    var jsonData = pm.response.json();",
                                    "    pm.expect(jsonData.status).to.eql(\"success\");",
                                    "});",
                                    "",
                                    "pm.test(\"Package is created with correct data\", function () {",
                                    "    var jsonData = pm.response.json();",
                                    "    pm.expect(jsonData.data).to.have.property('id');",
                                    "    pm.expect(jsonData.data.name).to.eql(pm.variables.get(\"package_name\"));",
                                    "    pm.expect(jsonData.data.type).to.eql(pm.variables.get(\"package_type\"));",
                                    "});",
                                    "",
                                    "// Save package ID for later use",
                                    "if (pm.response.code === 201) {",
                                    "    var jsonData = pm.response.json();",
                                    "    pm.collectionVariables.set(\"package_id\", jsonData.data.id);",
                                    "}"
                                ],
                                "type": "text/javascript"
                            }
                        },
                        {
                            "listen": "prerequest",
                            "script": {
                                "exec": [
                                    "// Set test data",
                                    "pm.variables.set(\"package_name\", \"Giáo Trình HSK 1-6\");",
                                    "pm.variables.set(\"package_type\", \"LEARNING_PATH\");",
                                    "pm.variables.set(\"package_description\", \"Bộ giáo trình tiếng Trung HSK đầy đủ từ cấp 1 đến 6\");",
                                    "pm.variables.set(\"package_thumbnail\", \"https://example.com/hsk-thumbnail.jpg\");"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{access_token}}"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"name\": \"{{package_name}}\",\n    \"type\": \"{{package_type}}\",\n    \"description\": \"{{package_description}}\",\n    \"thumbnail\": \"{{package_thumbnail}}\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/packages",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "packages"
                            ]
                        },
                        "description": "Create a new learning path (package)"

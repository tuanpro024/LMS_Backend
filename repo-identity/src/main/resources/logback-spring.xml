<configuration>
    <!-- Console appender for development -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Interaction log - structured JSON using standard PatternLayoutEncoder (no extra dependency) -->
    <appender name="INTERACTION_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH:-./logs}/interaction.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH:-./logs}/interaction-%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>30</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>{"timestamp":"%X{timestamp}","sessionId":"%X{sessionId}","userId":"%X{userId}","userRole":"%X{userRole}","eventType":"%X{eventType}","module":"%X{module}","targetId":"%X{targetId}","pageUrl":"%X{pageUrl}","metadata":%X{metadata:-null}}%n</pattern>
        </encoder>
    </appender>

    <!-- Root logger -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

    <!-- Dedicated logger for interaction events - writes only to file, not console -->
    <logger name="com.lms.identity.interaction" level="INFO" additivity="false">
        <appender-ref ref="INTERACTION_FILE"/>
    </logger>
</configuration>
